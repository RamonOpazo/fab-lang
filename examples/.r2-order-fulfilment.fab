Order :=
    *receive/Received validate? +(
        yes/Accepted fork! +(
            charge? +(paid, declined/Waiting/retry),
            reserve? +(reserved, short/Backorder/restock)
        )!
        ready/Ready ship/Shipped close*,
        no/Rejected notify*
    )

@Order :>
    class: [flow]
    // base style
    style: [dark]
    // single ref labels
    style/label: .Received  "Order received"
    style/label: .validate+ "Valid?"
    style/label: .charge+   "Payment accepted?"
    style/label: .Waiting   "Wait 10 min"
    style/label: .reserve+  "In stock?"
    style/label: .Shipped   "Shipped"
    style/label: .Rejected  "Rejected"
    // common labels on refs
    style/label: (.yes, .paid, .reserved) "yes"
    style/label: (.no, .declined, .short) "no"
    // shapes
    style/arrow: (.retry, .restock) [/dashed/>]
    style/bend:  (.retry, .restock) [inner]

# fAB grammar, Go-style EBNF. A permissive superset of fAB: the analyser
# rejects what spec.md forbids. spec.md is the truth.
#
#   a ~ b   b touches a        a _ b   whitespace or a comment between
#
# Precedence, loosest first: |  ,  operator  _  ~/~  prefix  juxtafix  postfix.
# Operators share one level, left to right; different ones need a group.
# EOL is whitespace inside { }, and ends the statement everywhere else.


program
    = [ statement ] { EOL [ statement ] } EOF
    ;

# Three forms (statements.md §22): a declaration (::), a naming (:=) and a
# description, which has no operator.
# DECL heads: a zone (G :: f g), a type (:Shape :: [circle], [box];
# :Style :: { … }; :Angle :: :Number!; :Tip :: :Head, :Hook!, :Nil;
# :Arrow :: [:Tip/:Stroke/:Tip]), or contexts and a descriptor (a
# signature: (&node, &zone) :fill :: :Color).
# DEFN heads: a value ([red]), a typed value (:Color [red]) or a descriptor
# (a bundle). A type is no value: never named with :=.
# A description is an entry: G :style { … }, G.f :arrow [epi], G { … }.
# The head is read as a part: :Color [red] is a chain of a type and a
# value, (&node) :fill an entry.
statement
    = part ( DECL | DEFN ) ( levels | block )
    | part
    ;

# {}, the empty record, is a value only: after a descriptor (G :style {})
# or as a naming's body (:Style [x] := {}). Elsewhere empty braces are a
# syntax error (G :: {}, :Style :: {}).
block
    = L_CUR [ levels ] R_CUR
    ;

levels
    = items { BAR items }
    ;

items
    = item { COMMA item }
    ;

# Inside braces the three forms nest: a naming binds a name in its record
# ([ink] := [#dddddd]), a declaration declares in the type being declared
# (&node :fill :: :Color, inside :Style :: { … }).
item
    = part [ ( DECL | DEFN ) part ]
    ;

part
    = [ chain ] ( attr | block )
    | chain { operator chain }
    ;

operator
    = IDEN
    | CONG
    ;

# A table's descriptor takes a key: :lemma.[merge] ( … ). ! touching a
# descriptor turns a flag off: f :hide!. A group after a descriptor is a
# proposition, the fifth shape of a value: :lemma.[a] (f h == g k); a block
# is a record: G :style { … }.
attr
    = ATTR_ID [ ~ DOT ~ VAL ] [ ~ BANG ] [ literal | L_PAR items R_PAR | block ]
    ;

literal
    = STR
    | MATH
    | VAL
    ;

chain
    = atom { infix atom }
    ;

infix
    = ~ SLASH ~
    | _
    ;

atom
    = prefix
    | juxtafix
    | postfix
    ;

prefix
    = marker ~ atom
    ;

juxtafix
    = postfix ~ DOT ~ atom
    ;

# A SLASH touching only its left is postfix: f/ g, #A/f/#B/.
# A marker touching the primary before it is postfix; touching both sides is
# an error: f+(g, h). Atoms that touch need a / between them.
# The grammar takes ? and ! on either side; the analyser keeps them on the
# right: f/?, (a, b)?. A prefix ? or ! is an error there: ?(a, b), !f.
postfix
    = primary [ ~ marker | ~ SLASH ]
    ;

marker
    = PLUS
    | QUID
    | BANG
    ;

# A ? or ! that touches no atom on its right is a node of that kind: the
# f/? in f/? +(a, b). Touching an atom, it is a prefix marker.
# A type is a primary, so that its twins are a postfix marker: :Number!.
# A table descriptor is declared by its key slot: &zone :axiom.[] :: :P.
primary
    = EDGE_ID
    | NODE_ID
    | ZONE_ID
    | CLASS_ID
    | TYPE_ID
    | AT
    | STAR
    | QUID
    | BANG
    | literal
    | L_PAR items R_PAR
    ;


# Tokens
#
#   ZONE_ID   G, User, A'          uppercase first
#   NODE_ID   #A, #UUID7           # then uppercase
#   EDGE_ID   f, h', user_id, α    lowercase, _ or non-ASCII first
#   ATTR_ID   :label, :label-start : then lowercase; - allowed
#   TYPE_ID   :Color, :UpperCamel  : then uppercase
#   CLASS_ID  &node                & then lowercase
#   STR       "…"                  one line, \ escapes
#   MATH      $…$                  one line, \ escapes
#   VAL       [red], [/solid/>], []  one opaque token; no whitespace, [ ] ( ) ,
#                                  / separates its elements, read later;
#                                  an empty element is nil: [] is nil;
#                                  type names make it a type: [:Tip/:Stroke/:Tip]
#
#   SLASH /   PLUS +   QUID ?   BANG !   STAR *   AT @   DOT .   BAR |
#   COMMA ,   IDEN ==  CONG ~=  DECL ::  DEFN :=  L_PAR (  R_PAR )
#   L_CUR {   R_CUR }  EOL      EOF
#
# Name bodies: letters, digits, _, ' and non-ASCII. Trivia: // comments,
# spaces, tabs, carriage returns. Anything else is INVALID.
